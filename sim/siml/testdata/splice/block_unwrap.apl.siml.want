siml 1
spec hunter

var $a = true
var $b = true
def fits(x) = spell(x).cast_time < 2s or not $a

priority:
  cast hunters_mark if not target.aura(hunters_mark).is_active
  // Weave block.
  cast aimed_shot if $a and $b and current_time > 1s
  # cast multi_shot if $a and $b
  cast serpent_sting if $a and $b and fits(serpent_sting)
  cast arcane_shot
