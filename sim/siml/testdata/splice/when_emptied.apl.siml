siml 1
spec hunter

var $a = true
var $b = true

priority:
  cast hunters_mark if not target.aura(hunters_mark).is_active
  when $a:
    cast aimed_shot
    // Only while both hold.
    when $b:
      cast multi_shot
  // Serpent Sting while b holds.
  when $b:
    cast serpent_sting
  cast arcane_shot
