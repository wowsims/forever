siml 1
spec hunter

var ${Move duration} = 1s
var $weave = true
// A def names a value; each call reads as its value, every parameter replaced by its argument.
def fits(x) = spell(x).cast_time + $move_duration <= 2s or not $weave
def early = current_time < 10s
def below(u, p) = u.current_health_percent < p
def active(u, a) = u.aura(a).is_active
def both(c) = c and current_time > 1s
// A def with no parameters whose value is a name stands for that name where a name goes.
def opener = aimed_shot
// A call in a var line's value.
var $early_weave = early and $weave

priority:
  // One parameter, in a ref position; the call keeps its value together in the and.
  cast multi_shot if $weave and fits(multi_shot)
  // No parameters, called bare and with ().
  cast x if early
  cast x if early() and $early_weave
  // Two parameters: a unit and an operand, and a unit and a ref of an accessor.
  cast x if below(target, 20%)
  // none is the empty unit, as an argument and before a dot.
  cast x if below(none, 20%) or none.current_health_percent < 30%
  cast hunters_mark if not active(target, hunters_mark)
  // An argument written as an or keeps its precedence.
  cast x if both($weave or early)
  // A def that is a name, as an action's spell, a ref, and an argument a parameter passes on.
  cast opener if spell(opener).is_ready and fits(opener)
  // A call in a when line's condition.
  when early:
    cast aimed_shot if fits(aimed_shot)
