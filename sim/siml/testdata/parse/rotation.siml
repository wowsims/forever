siml 1
spec dps_warrior

apl:
  var $execute = is_execute_phase(e20)

cooldowns:
  cooldowns(id=death_wish, timings=[30, 90])
  cooldowns(id=other.offensive_potion)
  hp_percent_for_defensives 0.4

prepull:
  -1.5s cast battle_shout

priority:
  cast execute if $execute
  group "Filler"

group "Filler":
  cast slam
