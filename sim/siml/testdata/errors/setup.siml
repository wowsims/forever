  offensive_pot falcons_call
  food steak
  extra=[falcons_call]
  elixir elixir_of_the_mongoose
  elixir greater_mageblood_elixir

buffs: battle_shout

encounter:
  targets(stats(armor=1, armour=2))
  targets(stats(armor=1, armor=2), target_inputs=[], target_inputs(label="x"))
