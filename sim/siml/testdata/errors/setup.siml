siml 1
spec hunter

settings:
  race orcs
  distance_from_target 11s
  quiver_bonus 3
  pet_uptime "full"
  cobra_reflex
  name "A", "B"
  healing_model(hps=1, nope=2)
  healing_model(hps=2)
