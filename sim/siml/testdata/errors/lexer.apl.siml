siml 1
spec hunter

// Lexer diagnostics: each token reports its own, and the statement is read only up to the first.
priority:
  cast x if @a
  cast x if a == "b
  cast x if a == "tab	inside"
  cast x if a == "bad \q escape"
  cast x if $ > 1
  cast x if ${unclosed > 1
  cast x if %
  cast x if !a && b || c
  cast x if a & b | c
  cast x if 5min > 1s
  cast x if 1.5x > 1s
  cast x if 1.x > 1s
  cast x if `{"unclosed": true
