{
	"comments": { "lineComment": "//" },
	"brackets": [
		["(", ")"],
		["[", "]"]
	],
	"autoClosingPairs": [
		{ "open": "(", "close": ")" },
		{ "open": "[", "close": "]" },
		{ "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
		{ "open": "`", "close": "`", "notIn": ["string", "comment"] }
	],
	"surroundingPairs": [
		["(", ")"],
		["[", "]"],
		["\"", "\""],
		["`", "`"]
	],
	"wordPattern": "[0-9]+(?:\\.[0-9]+)?(?:%|ns|us|µs|ms|s|m|h)?|[$%]\\{[^}\\n]*\\}|[$%]?[A-Za-z_][A-Za-z0-9_]*",
	"indentationRules": {
		"increaseIndentPattern": "^[A-Za-z_][A-Za-z0-9_]*\\s*:\\s*$|^group\\s+\"(?:[^\"\\\\]|\\\\.)*\"\\s*:\\s*$",
		"decreaseIndentPattern": "^(?!)"
	},
	"folding": { "offSide": true }
}
