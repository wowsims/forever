siml 1
spec hunter
use "common.apl.siml"

var ${Shoot spot} = 12
var ${Use Aimed Shot} = true
var ${Use Multi-Shot} = false
var ${Use Arcane Shot} = true
var ${Use Sniper Shot} = false
var ${Use Summon Hawk} = false

prepull:
  -22s cast hunters_mark
  -20s cast aspect_of_the_hawk
  -19s move $pull_range

priority:
  autocast_other_cooldowns if current_time >= 5s
  cast hunters_mark if not target.aura(hunters_mark).is_active
  cast aimed_shot if $use_aimed_shot
  cast serpent_sting if not dot(serpent_sting).is_active
  cast sniper_shot
      if $use_sniper_shot
      and (aura(rapid_fire).is_active or aura(quick_shots).is_active)
  reset_sequence("HHA") if hawk_and_arcane and sequence("HHA").is_complete
  sequence "HHA" [cast summon_hawk, cast summon_hawk, cast arcane_shot] if hawk_and_arcane
  cast summon_hawk if $use_summon_hawk and not $use_arcane_shot
  cast arcane_shot if $use_arcane_shot and not $use_summon_hawk
  cast multi_shot if $use_multi_shot
  /// Start of the fight: get to my spot without losing an Auto Shot.
  group "Walk in" if self.unit_distance != $shoot_spot

group "Walk in":
  /// Walk to my spot, looking again every reaction time. Stop while my Auto Shot is due here, and react to each shot before walking on.
  move $shoot_spot recheck if not shot_due_here
  /// Standing for my Auto Shot.
  wait input_delay
