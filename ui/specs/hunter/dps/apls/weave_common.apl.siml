siml 1
spec hunter
use "walk_in.apl.siml" with $shoot_spot = max($ranged_range, 11.67)
use "pull.apl.siml"

// The walk times of a melee weave, from the run speed, and when a weave fits before the next Auto Shot. A weave walks
// in for the next main-hand swing and is back before the Auto Shot it delays is more than Max Auto Shot delay late
// (Max long weave delay when one walk in and out outlasts an Auto Shot cycle). A rotation sets Wait at melee with
// use … with to stay longer at melee.
var ${Ranged range} = 13.19
var ${Walk-in range} = 4.99
var ${Wait at melee} = input_delay
var ${Max Auto Shot delay} = 2.4s
var ${Max long weave delay} = 4s
var ${Melee spot} = min($walk_in_range, 4.99)
var ${Run speed} = self.unit_movement_speed
var ${Time to melee} = 1s * ((self.unit_distance - $melee_spot) / $run_speed)
var ${Time to range} = 1s * (($shoot_spot - $melee_spot) / $run_speed)
var ${Time to walk in} = auto_time_to_next(main_hand_auto) - $time_to_melee - input_delay
var ${Weave done} =
    max(auto_time_to_next(main_hand_auto), $time_to_melee) + $time_to_range + ($wait_at_melee + input_delay)
var ${Allowed delay} =
    max($max_auto_shot_delay, min($max_long_weave_delay, $weave_done - auto_swing_time(ranged) + 1s))
var ${Weave fits} = auto_time_to_next(ranged_auto) + $allowed_delay >= $weave_done
var ${Not weaving yet} = auto_time_since_last(main_hand_auto) > current_time

def walk_in_now =
    $time_to_walk_in <= 0s
    and $weave_fits
    and auto_time_to_next(ranged_auto) > 500ms
    and at_range
def kick_wait = max(spell(strider_kick).time_to_ready, gcd_time_to_ready)
def kick_soon =
    in_melee
    and spell(strider_kick).is_known
    and spell(strider_kick).current_cost <= current_mana
    and kick_wait > 0s
    and kick_wait <= 400ms
