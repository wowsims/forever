siml 1
spec retribution_paladin

var ${Has assigned judgement} = true
var ${Use Seal of Command} = true
var ${Use Seal of Righteousness} = true
var ${Max Seal of Command Stacks} = 3
var ${Max Seal of Righteousness Stacks} = 1
var ${Delay Major CDs} = 0s
var ${Pull range} = 25
var ${Melee range} = 5
var ${MCP Max Seal of Righteousness Stacks} = 3
var ${MCP Max Seal of Fury Stacks} = 1
// Under Unsealed Wrath with the Manual Crowd Pummeler in the swap set, the rotation equips it before the pull. While
// it is equipped, Seal of Righteousness twists with Seal of Fury and Judgement is cast under Seal of Righteousness
// only, since Judgement of Fury taunts. Once its Haste is over the main hand swaps back right after a swing, and Seal
// of Command twists with Seal of Righteousness again.
var ${MCP twist} =
    talent_is_known(unsealed_wrath)
    and spell(item.manual_crowd_pummeler).is_known
    and active_item_swap_set(swap1)
var ${Should swap} =
    talent_is_known(unsealed_wrath)
    and spell(item.manual_crowd_pummeler).is_known
    and aura(haste).is_inactive(include_reaction_time=true)
    and auto_time_since_last(main_hand_auto) <= 0.1s
var ${Should swap from MCP} =
    $should_swap
    and active_item_swap_set(swap1)
    and spell(item.manual_crowd_pummeler).time_to_ready > 40s
var ${Should swap to MCP} =
    $should_swap
    and active_item_swap_set(main)
    and spell(item.manual_crowd_pummeler).time_to_ready <= 32s
    and remaining_time > 35s
var ${Should swap to SoF} =
    $mcp_twist
    and aura(seal_of_fury_20423_tag0).is_inactive(include_reaction_time=true)
    and aura(echo_of_righteousness).num_stacks(include_reaction_time=true) >= $mcp_max_seal_of_righteousness_stacks
    and $judge_realism_protection
    and $judgement_outlasts_the_swap
    and $can_pay_for_both_swaps
var ${Should swap to SoR from SoF} =
    $mcp_twist
    and aura(seal_of_righteousness_20293).is_inactive(include_reaction_time=true)
    and (aura(seal_of_fury_20423_tag0).is_inactive or aura(echo_of_fury).num_stacks(include_reaction_time=true) >= $mcp_max_seal_of_fury_stacks)
    and $judge_realism_protection
// Mana for the swap to Seal of Fury and the swap back. Without the swap back, Judgement stays unused under Seal of
// Fury.
var ${Can pay for both swaps} =
    current_mana >= spell(seal_of_fury).current_cost + spell(seal_of_righteousness).current_cost
var ${Should refresh SoC} =
    not $mcp_twist
    and ($use_seal_of_command or not $use_seal_of_righteousness or talent_is_known(unsealed_wrath))
    and (aura(seal_of_command_20920).is_inactive or aura(seal_of_command_20920).is_active and aura(seal_of_command_20920).remaining_time <= auto_time_to_next(main_hand_auto))
    and (not talent_is_known(unsealed_wrath) or aura(seal_of_command_20920).is_inactive(include_reaction_time=true) and aura(echo_of_righteousness).num_stacks(include_reaction_time=true) >= $max_seal_of_righteousness_stacks or $twist_has_stopped)
    and $judge_realism_protection
// Under Unsealed Wrath the swap waits for Judgement only while Seal of Command is up. With no seal up Judgement
// cannot be cast and stays ready.
var ${Should refresh SoR} =
    not $mcp_twist
    and ($use_seal_of_righteousness or not talent_is_known(seal_of_command_rank1) or talent_is_known(unsealed_wrath))
    and (not $use_seal_of_command or not talent_is_known(seal_of_command_rank1) or talent_is_known(unsealed_wrath))
    and (aura(seal_of_righteousness_20293).is_inactive or aura(seal_of_righteousness_20293).is_active and aura(seal_of_righteousness_20293).remaining_time <= auto_time_to_next(main_hand_auto))
    and (not talent_is_known(unsealed_wrath) or not talent_is_known(seal_of_command_rank1) or aura(seal_of_righteousness_20293).is_inactive(include_reaction_time=true) and aura(echo_of_command).num_stacks(include_reaction_time=true) >= $max_seal_of_command_stacks and (aura(seal_of_command_20920).is_inactive or $judgement_outlasts_the_swap))
    and $judge_realism_protection
var ${Judge realism protection} =
    spell(judgement).time_to_ready <= spell(judgement).full_cooldown - input_delay
// Judgement's cooldown outlasts the next swing and the global cooldown after it. Under Unsealed Wrath the
// swap from Seal of Command to Seal of Righteousness waits for that, so Judgement unleashes Seal of Command.
var ${Judgement outlasts the swap} =
    spell(judgement).time_to_ready >= auto_time_to_next(main_hand_auto) + spell(seal_of_righteousness).gcd_hasted_duration
// Neither Seal of Command nor Seal of Righteousness is up and neither Echo holds the stacks its swap asks for,
// so neither swap is due. A weapon swap clears every Echo, so this holds after the swap back from the Manual Crowd
// Pummeler. Under Unsealed Wrath Seal of Command is cast then.
var ${Twist has stopped} =
    aura(seal_of_command_20920).is_inactive(include_reaction_time=true)
    and aura(seal_of_righteousness_20293).is_inactive(include_reaction_time=true)
    and aura(echo_of_command).num_stacks(include_reaction_time=true) < $max_seal_of_command_stacks
    and aura(echo_of_righteousness).num_stacks(include_reaction_time=true) < $max_seal_of_righteousness_stacks

prepull:
  -30s item_swap(swap1)
      if talent_is_known(unsealed_wrath)
      and spell(item.manual_crowd_pummeler).is_known
  -20s group "Activate assigned aura"
  -20s move $pull_range
  -3s group "Prep Seal of Command"
  -1.5s group "Prep Seal of Righteousness"
  -1.5s group "Cast assigned judgement"

priority:
  group "Move to melee" if not spell(holy_strike).in_range
  group "MCP swap"
  cast judgement if aura(seal_of_fury_20423_tag0).is_inactive
  autocast_other_cooldowns if current_time >= $delay_major_cds
  cast hammer_of_wrath
      if spell(hammer_of_wrath).cast_time == 0s
      or auto_time_since_last(main_hand_auto) < 0.2s
  cast holy_strike if $judge_realism_protection
  cast seal_of_fury if $should_swap_to_sof
  cast seal_of_righteousness if $should_swap_to_sor_from_sof
  cast seal_of_command if $should_refresh_soc
  cast seal_of_righteousness if $should_refresh_sor
  group "Consecration"
  group "Exorcism"

group "Activate assigned aura":
  cast retribution_aura

group "Cast assigned judgement":
  cast seal_of_the_crusader if $has_assigned_judgement

group "Prep Seal of Command":
  cast seal_of_command if not $has_assigned_judgement and $use_seal_of_command and not $mcp_twist

group "Prep Seal of Righteousness":
  cast seal_of_righteousness
      if not $has_assigned_judgement
      and ($mcp_twist or $use_seal_of_righteousness and (not $use_seal_of_command or not talent_is_known(seal_of_command_rank1)))

group "MCP swap":
  item_swap(main) if $should_swap_from_mcp
  item_swap(swap1) if $should_swap_to_mcp

group "Move to melee":
  sequence "move1" [move $melee_range, wait until spell(judgement).in_range, cast judgement, wait input_delay, cast seal_of_command, wait until spell(holy_strike).in_range]
      if $has_assigned_judgement
      and talent_is_known(seal_of_command_rank1)
      and ($use_seal_of_command or not $use_seal_of_righteousness or talent_is_known(unsealed_wrath))
      and not $mcp_twist
      and not sequence("move1").is_complete
  sequence "move2" [move $melee_range, wait until spell(judgement).in_range, cast judgement, wait input_delay, cast seal_of_righteousness, wait until spell(holy_strike).in_range]
      if $has_assigned_judgement
      and ($mcp_twist or not talent_is_known(unsealed_wrath) or not talent_is_known(seal_of_command_rank1) or not $use_seal_of_command)
      and not sequence("move2").is_complete
  sequence "move3" [move $melee_range, wait until spell(judgement).in_range, cast judgement, wait until spell(holy_strike).in_range]
      if not $has_assigned_judgement
      and not sequence("move3").is_complete

group "Exorcism":
  cast exorcism if current_mana_percent >= 10%

group "Consecration":
  cast consecration if current_mana_percent >= 10%
