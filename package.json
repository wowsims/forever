{
	"name": "forever",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"volta": {
		"node": "26.13.0"
	},
	"scripts": {
		"start": "cross-env WATCH=1 make devmode",
		"build": "make host",
		"build:lsp": "go build -o /dev/null ./tools/spelldata && make vscode-spelldata",
		"format": "npm run lint:fix && npm run fmt:fix",
		"lint": "npm run lint:js && npm run lint:css",
		"lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
		"lint:js": "npx oxlint --max-warnings 0 ./ui ./.storybook",
		"lint:js:fix": "npm run lint:js -- --fix",
		"lint:css": "stylelint \"./ui/**/*.css\"",
		"lint:css:fix": "npm run lint:css -- --fix",
		"fmt": "npx oxfmt . --check",
		"fmt:fix": "npx oxfmt .",
		"type-check": "node_modules/typescript/bin/tsc --noEmit",
		"test:unit": "vitest run",
		"test:locales": "node ./test-locales.mjs",
		"storybook:dev": "storybook dev -p 6006 --no-open",
		"storybook:build": "storybook build --quiet",
		"skills:install": "npx -y skills@1.7.4 add ./.github/skills -y && npx -y skills@1.7.4 add blader/humanizer -y"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@fortawesome/fontawesome-svg-core": "7.3.1",
		"@fortawesome/free-brands-svg-icons": "7.3.1",
		"@fortawesome/free-regular-svg-icons": "7.3.1",
		"@fortawesome/free-solid-svg-icons": "7.3.1",
		"@fortawesome/react-fontawesome": "3.5.0",
		"@tanstack/react-table": "9.3.1",
		"@tanstack/react-virtual": "3.14.10",
		"@types/golang-wasm-exec": "^1.15.2",
		"@types/pako": "^2.0.4",
		"ajv": "^8.20.0",
		"async": "^3.2.6",
		"chart.js": "^4.6.1",
		"clsx": "^2.1.1",
		"highs": "1.15.2",
		"i18next": "^26.6.0",
		"i18next-browser-languagedetector": "^8.2.4",
		"idb": "^8.0.4",
		"pako": "^2.2.0",
		"react": "^19.3.1",
		"react-chartjs-2": "5.3.1",
		"react-dom": "^19.3.1",
		"react-i18next": "17.1.9",
		"react-tooltip": "^6.0.9",
		"react-use": "17.6.1",
		"shallow-equal": "^3.1.0",
		"tailwindcss": "^4.3.3",
		"uuid": "^14.0.3",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@bufbuild/buf": "1.75.0",
		"@happy-dom/global-registrator": "^21.0.4",
		"@protobuf-ts/plugin": "2.9.1",
		"@protobuf-ts/plugin-framework": "2.9.0",
		"@protobuf-ts/protoc": "2.9.1",
		"@protobuf-ts/runtime": "2.9.1",
		"@storybook/addon-docs": "^10.6.5",
		"@storybook/react-vite": "^10.6.5",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/async": "^3.2.26",
		"@types/gtag.js": "^0.0.20",
		"@types/minimist": "^1.2.5",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"cross-env": "^10.1.0",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"glob": "^14.0.3",
		"happy-dom": "^21.0.4",
		"http-server": "14.1.1",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"storybook": "^10.6.5",
		"stylelint": "^17.16.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vite-plugin-checker": "^0.14.5",
		"vite-plugin-i18next-loader": "^4.1.0",
		"vite-plugin-watch-and-run": "^1.8.4",
		"vitest": "^5.0.5"
	},
	"overrides": {
		"http-server": {
			"html-encoding-sniffer": "^6.0.0"
		},
		"vite-plugin-i18next-loader": {
			"glob": "$glob"
		}
	}
}
